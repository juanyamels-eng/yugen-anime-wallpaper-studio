# Copia este archivo como `keystore.properties` (NO lo subas a git)
# y genera tu keystore UNA vez con:
# keytool -genkeypair -v -keystore yugen-release.keystore -alias yugen -keyalg RSA -keysize 2048 -validity 10000
storeFile=yugen-release.keystore
storePassword=CAMBIA_ESTA_CLAVE
keyAlias=yugen
keyPassword=CAMBIA_ESTA_CLAVE
